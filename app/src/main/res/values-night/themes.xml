<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant of the platform theme; see the light counterpart. -->
    <style name="Theme.Capsule" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>

    <!-- Translucent, dimmed host for the headless cross-profile activities. -->
    <style name="Theme.Capsule.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
